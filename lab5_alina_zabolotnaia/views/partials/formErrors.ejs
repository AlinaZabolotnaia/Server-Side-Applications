<%# Общий блок со списком ошибок формы %>
<% if (Object.keys(errors).length > 0) { %>
    <div class="alert alert-error">
        <strong>Данные не сохранены. Исправьте ошибки:</strong>
        <ul>
            <% Object.values(errors).forEach((message) => { %>
                <li><%= message %></li>
            <% }) %>
        </ul>
    </div>
<% } %>
